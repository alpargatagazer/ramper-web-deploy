# System Configuration
TZ=Europe/Madrid

# App Image (auto-deployed by Watchtower)
RAMPER_IMAGE=ghcr.io/alpargatagazer/ramper-web:latest

# Ports (Internal to Caddy but exposed to host)
WEB_PORT=8123
KUMA_PORT=8124
DOZZLE_PORT=8125
LISTMONK_PORT=8126

# Paths
VOLUMES_PATH=./volumes

# Services
# Override the internal listmonk URL
LISTMONK_URL=http://listmonk:9000
# Listmonk Public Subscription List ID and UUID (found in the Listmonk admin panel under Lists)
PUBLIC_NEWSLETTER_LIST_ID=your-list-id-here
PUBLIC_NEWSLETTER_LIST_UUID=your-list-uuid-here
